pipeline {
    agent { 
        node {
            label 'Project_101_Windows'
            }
      }
    tools{
		jdk 'jdk-21'
    }
    triggers {
        pollSCM '* * * * *'
    }
    stages {
        stage('Build') {
            steps {
		//bat 'chmod +x gradlew'
		bat './gradlew clean assemble'
            }
        }
        stage('Test') {
            steps {
		bat './gradlew test'
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'build/libs/*.jar', fingerprint: true
            }
        }
    }
}